{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@_shared/ingredient/infra-rxdb": [
        "libs/shared/ingredient/infra-rxdb/src/index.ts"
      ],
      "@_shared/recipe-collection/application": [
        "libs/shared/recipe-collection/application/src/index.ts"
      ],
      "@_shared/recipe-collection/infra-rxdb": [
        "libs/shared/recipe-collection/infra-rxdb/src/index.ts"
      ],
      "@_shared/recipe/infra-rxdb": [
        "libs/shared/recipe/infra-rxdb/src/index.ts"
      ],
      "@_shared/tag/application": ["libs/shared/tag/application/src/index.ts"],
      "@_shared/tag/infra-rxdb": ["libs/shared/tag/infra-rxdb/src/index.ts"],
      "@overckd/core": ["libs/core/src/index.ts"],
      "@overckd/domain": ["libs/domain/src/index.ts"],
      "@overckd/domain-experimental": [
        "libs/@overckd/domain-experimental/src/index.ts"
      ],
      "@overckd/domain-rx": ["libs/domain-rx/src/index.ts"],
      "@overckd/server": ["libs/server/src/index.ts"],
      "@overckd/yaml": ["libs/yaml/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
