  "scripts": {
    "build:desktop": "nx run-many -t build:desktop",
    "build": "nx run-many -t build",
    "build:watch": "nx run-many -t build:watch --parallel --stream",
    "clean": "nx run-many -t clean --parallel",
    "start:desktop": "nx run-many -t build:desktop && nx run-many -t start:desktop --parallel",
    "start:web": "nx run-many -t start:web --parallel",
    "start": "yarn run start:web",
    "app:desktop:dev": "nx run-many -t app:desktop:dev",
    "app:desktop": "nx run-many -t app:desktop",
    "test": "nx run-many -t test --parallel",
    "test:jest": "jest",
    "test:coverage": "jest --coverage",
    "lint": "nx run-many -t lint --parallel",
    "prepare": "husky install"
